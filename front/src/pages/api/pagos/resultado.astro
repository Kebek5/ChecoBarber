---
import BaseLayout from '@/presentation/components/layout/BaseLayout.astro'
import { buttonVariants } from '@/presentation/components/ui/button'
import { paymentGateway } from '@/infrastructure/container'

const orderId = Astro.url.searchParams.get('orderId') ?? ''
const ref = Astro.url.searchParams.get('payment_id') ?? ''   // lo manda Mercado Pago
let paid = false
let error = ''
try {
  paid = (await paymentGateway.confirm(Astro.locals.token!, orderId, ref)).paid
} catch (e) {
  error = e instanceof Error ? e.message : 'No se pudo verificar el pago.'
}
---

<BaseLayout title="Resultado del pago | ChecoBarber">
  <div class="mx-auto flex min-h-125 max-w-300 flex-col items-center justify-center px-7.5 py-12.5 text-center">
    <h1 class="mb-2.5 text-4xl font-bold">
      {error ? 'Hubo un problema' : paid ? '¡Pago recibido!' : 'Pago pendiente'}
    </h1>
    <p class="mb-6 text-muted-foreground">
      {error || (paid
        ? `Tu pedido #${orderId} fue pagado correctamente.`
        : `Tu pedido #${orderId} aún no tiene un pago confirmado.`)}
    </p>
    <a href="/" class={buttonVariants({ variant: 'outline', size: 'lg' })}>Volver a la tienda</a>
  </div>
</BaseLayout>