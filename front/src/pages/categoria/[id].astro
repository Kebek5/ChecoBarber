---
import type { Category } from '@/domain/catalog/Category'
import { getCategories, getCategoryById } from '@/infrastructure/container'
import { truncate } from '@/presentation/components/lib/seo'
import Shop from '@/presentation/components/customer/Shop.astro'
import BaseLayout from '@/presentation/components/layout/BaseLayout.astro'

const { id } = Astro.params

let categories: Category[] = []
let category: Category | null = null
let error = ''

try {
  categories = await getCategories.execute()
  category = await getCategoryById.execute(id ?? '')
} catch (err) {
  error = err instanceof Error ? err.message : 'Error de conexión.'
}

if (!error && !category) Astro.response.status = 404

const name = category?.name ?? 'Categoría'
const title = truncate(`${name} | ChecoBarber`, 60)
const description = truncate(
  category?.description?.trim() ||
    `Productos de ${name} en ChecoBarber: cuidado para cabello y barba. Compra en línea.`,
  160
)
---

<BaseLayout title={title} description={description} noindex={!category}>
  <Shop
    categories={categories}
    products={category?.products ?? []}
    activeCategoryId={id ?? null}
    error={error}
  />
</BaseLayout>