---
import { toMessage } from '@/presentation/components/lib/adminError'
import { bookAppointment, getAvailableHours, listMyAppointments, listServices } from '@/infrastructure/container'
// import { PUBLIC_SHOP_MAP_QUERY } from 'astro:env/client'
import { PUBLIC_SHOP_MAP_QUERY } from 'astro:env/client'
import type { Appointment } from '@/domain/appointment/Appointment'
import type { Service } from '@/domain/appointment/Service'
import BaseLayout from '@/presentation/components/layout/BaseLayout.astro'
import ShopMap from '@/presentation/components/customer/ShopMap.astro'
import StatusBadge from '@/presentation/components/admin/StatusBadge.astro'
import Notice from '@/presentation/components/admin/Notice.astro'
import { buttonVariants } from '@/presentation/components/ui/button'
import { Input } from '@/presentation/components/ui/input'
import { formatDate, formatPrice, todayISO } from '@/presentation/components/lib/format'
import { googleCalendarLink } from '@/presentation/components/lib/calendarLink'

const user = Astro.locals.user
const token = Astro.locals.token

let serviceId = Astro.url.searchParams.get('servicio') ?? ''
let date = Astro.url.searchParams.get('fecha') ?? ''
let error = ''
let success = Astro.url.searchParams.get('ok') ? '¡Cita agendada! Te esperamos.' : ''

if (Astro.request.method === 'POST') {
   const form = await Astro.request.formData()
   serviceId = String(form.get('servicio') ?? '')
   date = String(form.get('fecha') ?? '')
   const hour = String(form.get('hora') ?? '')

   if (!token) return Astro.redirect('/login?next=/citas')

   try {
      await bookAppointment.execute(token, { date, hour, serviceId })
      return Astro.redirect('/citas?ok=1')
   } catch (err) {
      error = toMessage(err, 'No se pudo agendar la cita.')
   }
}

let services: Service[] = []
try {
   services = await listServices.execute()
} catch (err) {
   error = error || toMessage(err, 'No se pudieron cargar los servicios.')
}

let hours: string[] = []
const selected = services.find((service) => service.id === serviceId)
if (selected && date) {
   try {
      hours = await getAvailableHours.execute(date, selected.id)
   } catch (err) {
      error = error || toMessage(err, 'No se pudieron consultar los horarios.')
   }
}

let mine: Appointment[] = []
if (token) {
   try {
      mine = (await listMyAppointments.execute(token))
         .filter((appointment) => appointment.status !== 'CANCELLED')
         .sort((a, b) => b.date.localeCompare(a.date) || b.hour.localeCompare(a.hour))
   } catch {
      /* si falla, solo no se muestra el historial */
   }
}

const today = todayISO()
const selectClass = 'w-full border bg-transparent px-2.5 py-1.5 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring'
---

<BaseLayout title="ChecoBarber | Agenda tu cita">
   <div class="mx-auto flex w-full max-w-300 flex-col gap-10 p-6">
      <header>
         <h1 class="text-2xl font-bold">Agenda tu cita</h1>
         <p class="mt-1 text-sm text-muted-foreground">Elige servicio y día; te mostramos solo los horarios libres (lunes a sábado, 10:00 a 19:00).</p>
      </header>

      <Notice error={error} success={success} />

      <section class="grid gap-8 md:grid-cols-2">
         <div class="flex flex-col gap-6">
            <!-- Paso 1: servicio y fecha -->
            <form method="get" class="flex flex-col gap-4">
               <h2 class="text-lg font-bold">1. Servicio y fecha</h2>
               <div class="flex flex-col gap-1">
                  <label for="servicio" class="text-xs font-bold">Servicio</label>
                  <select id="servicio" name="servicio" required class={selectClass}>
                     <option value="" disabled selected={!serviceId}>Elige un servicio</option>
                     {services.map((service) => (
                        <option value={service.id} selected={service.id === serviceId}>
                           {service.name} · {service.duration} · {formatPrice(service.price)}
                        </option>
                     ))}
                  </select>
               </div>
               <div class="flex flex-col gap-1">
                  <label for="fecha" class="text-xs font-bold">Fecha</label>
                  <Input id="fecha" name="fecha" type="date" min={today} required defaultValue={date} />
               </div>
               <button type="submit" class={buttonVariants({ variant: 'outline', size: 'lg' })}>Ver horarios</button>
            </form>

            <!-- Paso 2: horario -->
            {selected && date && (
               <form method="post" class="flex flex-col gap-4">
                  <h2 class="text-lg font-bold">2. Elige tu horario</h2>
                  <input type="hidden" name="servicio" value={selected.id} />
                  <input type="hidden" name="fecha" value={date} />

                  {hours.length === 0 ? (
                     <p class="text-xs text-muted-foreground">No hay horarios libres ese día. Prueba con otra fecha.</p>
                  ) : (
                     <div class="grid grid-cols-3 gap-2 sm:grid-cols-4">
                        {hours.map((hour, index) => (
                           <label class="cursor-pointer border px-2 py-1.5 text-center text-xs has-checked:bg-foreground has-checked:text-background">
                              <input type="radio" name="hora" value={hour} required={index === 0} class="sr-only" />
                              {hour}
                           </label>
                        ))}
                     </div>
                  )}

                  {user ? (
                     hours.length > 0 && (
                        <button type="submit" class={buttonVariants({ size: 'lg' })}>
                           Confirmar cita · {formatPrice(selected.price)}
                        </button>
                     )
                  ) : (
                     <a href={`/login?next=${encodeURIComponent(`/citas?servicio=${selected.id}&fecha=${date}`)}`} class={buttonVariants({ size: 'lg' })}>
                        Inicia sesión para confirmar
                     </a>
                  )}
               </form>
            )}
         </div>

         <ShopMap />
      </section>

      {user && (
         <section class="flex flex-col gap-3">
            <h2 class="text-lg font-bold">Mis citas</h2>
            {mine.length === 0 ? (
               <p class="text-xs text-muted-foreground">Todavía no tienes citas.</p>
            ) : (
               <ul class="flex flex-col gap-2">
                  {mine.map((appointment) => (
                     <li class="flex flex-wrap items-center justify-between gap-3 border p-3 text-xs">
                        <div>
                           <div class="font-bold">{appointment.service.name}</div>
                           <div class="text-muted-foreground">
                              {formatDate(appointment.date)} · {appointment.hour} · {formatPrice(appointment.price)}
                           </div>
                        </div>
                        <div class="flex items-center gap-3">
                           <StatusBadge kind="appointment" status={appointment.status} />
                           {appointment.status === 'PENDING' && (
                              <a
                                 href={googleCalendarLink({
                                    title: `Cita en ChecoBarber: ${appointment.service.name}`,
                                    date: appointment.date,
                                    hour: appointment.hour,
                                    minutes: parseInt(appointment.service.duration, 10) || 30,
                                    location: PUBLIC_SHOP_MAP_QUERY,
                                 })}
                                 target="_blank"
                                 rel="noopener noreferrer"
                                 class="font-bold underline"
                              >
                                 Agregar a mi Google Calendar
                              </a>
                           )}
                        </div>
                     </li>
                  ))}
               </ul>
            )}
         </section>
      )}
   </div>
</BaseLayout>