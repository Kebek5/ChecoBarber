---
import InvoiceAdmin from '@/presentation/components/admin/InvoiceAdmin'
import AdminLayout from '@/presentation/components/layout/AdminLayout.astro'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login?next=/dashboard/facturas')
if (user.role !== 'ADMIN') return Astro.redirect('/')
---

<AdminLayout title="Facturas | ChecoBarber">
   <section class="mx-auto w-full max-w-300 p-6">
      <h1 class="mb-1 text-2xl font-bold">Facturas</h1>
      <p class="mb-6 text-sm text-muted-foreground">
         Pedidos pagados. Genera la factura con el RFC del cliente (o a Público en general) y envíala por correo.
      </p>
      <InvoiceAdmin client:only="react" />
   </section>
</AdminLayout>