---
import type { AdminStats } from '@/domain/admin/AdminStats'
import type { DashboardSummary } from '@/domain/admin/DashboardSummary'
import { orderUnits } from '@/domain/order/AdminOrder'
import { getAdminStats, getDashboardSummary } from '@/infrastructure/container'
import BaseLayoutAdmin from '@/presentation/components/layout/AdminLayout.astro'
import DataTable from '@/presentation/components/admin/DataTable.astro'
import Notice from '@/presentation/components/admin/Notice.astro'
import PageHeader from '@/presentation/components/admin/PageHeader.astro'
import StatCard from '@/presentation/components/admin/StatCard.astro'
import StatusBadge from '@/presentation/components/admin/StatusBadge.astro'
import ChartCard from '@/presentation/components/admin/ChartCard.astro'
import ColumnChart from '@/presentation/components/admin/ColumnChart.astro'
import BarList from '@/presentation/components/admin/BarList.astro'
import DonutChart from '@/presentation/components/admin/DonutChart.astro'
import Heatmap from '@/presentation/components/admin/Heatmap.astro'
import LineChart from '@/presentation/components/admin/LineChart.astro'
import StackedColumnChart from '@/presentation/components/admin/StackedColumnChart.astro'
import { monthLabel, shortDate } from '@/presentation/components/admin/chartUtils'
import { toMessage } from '@/presentation/components/lib/adminError'
import { formatDate, formatPrice, todayISO } from '@/presentation/components/lib/format'

let summary: DashboardSummary | null = null
let stats: AdminStats | null = null
let error = ''
let statsError = ''

const token = Astro.locals.token!
// Las gráficas se piden aparte: si fallan, el resumen y las tablas siguen funcionando
const [summaryResult, statsResult] = await Promise.allSettled([
   getDashboardSummary.execute(token, todayISO()),
   getAdminStats.execute(token, 30),
])
if (summaryResult.status === 'fulfilled') summary = summaryResult.value
else error = toMessage(summaryResult.reason, 'No se pudo cargar el resumen.')
if (statsResult.status === 'fulfilled') stats = statsResult.value
else statsError = toMessage(statsResult.reason, 'No se pudieron cargar las gráficas.')

const sum = (values: number[]) => values.reduce((a, b) => a + b, 0)
const shopRevenue = stats ? sum(stats.salesByMonth.map((m) => m.shop)) : 0
const paidOrders = stats ? sum(stats.salesByDay.map((d) => d.orders)) : 0
---

<BaseLayoutAdmin title="Resumen | Administración">
   <PageHeader title="Resumen" description="Estado actual de la tienda y de la agenda." />
   <Notice error={error || statsError} />

   {summary && (
      <div class="p-4">
         <div class="mb-8 grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-4">
            <StatCard label="Ventas (pedidos completados)" value={formatPrice(summary.revenue)} />
            <StatCard label="Pedidos pendientes" value={summary.pendingOrders} href="/dashboard/pedidos?estado=PENDING" />
            <StatCard label="Pedidos en proceso" value={summary.inProcessOrders} href="/dashboard/pedidos?estado=IN_PROCESS" />
            <StatCard label="Citas hoy" value={summary.appointmentsToday} hint={`${summary.upcomingAppointments} próximas en total`} href="/dashboard/citas" />
            <StatCard label="Productos con stock bajo" value={summary.lowStockProducts.length} />
            <StatCard label="Clientes" value={summary.customers} href="/dashboard/usuarios" />
            {stats && (
               <>
                  <StatCard label="Cobrado en tienda (6 meses)" value={formatPrice(shopRevenue)} hint="Pedidos con pago aprobado" />
                  <StatCard label="Ingresos por citas (6 meses)" value={formatPrice(sum(stats.salesByMonth.map((m) => m.appointments)))} hint="Citas completadas" />
                  <StatCard label={`Pedidos en ${stats.days} días`} value={paidOrders} />
               </>
            )}
         </div>

         {stats && (
            <>
               <h2 class="mb-3 text-sm font-bold">Ingresos</h2>
               <div class="mb-8 grid gap-4 xl:grid-cols-2">
                  <div class="xl:col-span-2">
                     <ChartCard title="Ingresos por día" description={`Tienda (pagos aprobados) y citas completadas, últimos ${stats.days} días.`}>
                        <LineChart
                           caption="Gráfica de líneas: ingresos diarios de la tienda y de las citas"
                           labels={stats.salesByDay.map((d) => shortDate(d.date))}
                           hints={stats.salesByDay.map((d) => formatDate(d.date))}
                           series={[
                              { name: 'Tienda', color: 'var(--viz-1)', values: stats.salesByDay.map((d) => d.shop) },
                              { name: 'Citas', color: 'var(--viz-2)', values: stats.salesByDay.map((d) => d.appointments) },
                           ]}
                           money
                           width={1100}
                           height={260}
                        />
                     </ChartCard>
                  </div>
                  <ChartCard title="Ingresos por mes" description="Últimos 6 meses, tienda y citas apiladas.">
                     <StackedColumnChart
                        caption="Gráfica de columnas apiladas: ingresos mensuales de tienda y citas"
                        labels={stats.salesByMonth.map((m) => monthLabel(m.month))}
                        series={[
                           { name: 'Tienda', color: 'var(--viz-1)', values: stats.salesByMonth.map((m) => m.shop) },
                           { name: 'Citas', color: 'var(--viz-2)', values: stats.salesByMonth.map((m) => m.appointments) },
                        ]}
                        money
                     />
                  </ChartCard>
                  <ChartCard title="Ingresos por categoría" description="Productos vendidos con pago aprobado.">
                     <DonutChart data={stats.revenueByCategory} money empty="Aún no hay ventas cobradas." />
                  </ChartCard>
               </div>

               <h2 class="mb-3 text-sm font-bold">Pedidos y pagos</h2>
               <div class="mb-8 grid gap-4 xl:grid-cols-3">
                  <ChartCard title="Pedidos por estado" description="Todos los pedidos registrados.">
                     <DonutChart data={summary.ordersByStatus} centerLabel="Pedidos" empty="Todavía no hay pedidos." />
                  </ChartCard>
                  <ChartCard title="Método de pago" description="Cuántos pedidos usa cada método.">
                     <DonutChart data={stats.ordersByPaymentMethod} centerLabel="Pedidos" empty="Todavía no hay pedidos." />
                  </ChartCard>
                  <ChartCard title="Estado del pago" description="Aprobados, pendientes, rechazados y más.">
                     <DonutChart data={stats.ordersByPaymentStatus} centerLabel="Pedidos" empty="Todavía no hay pedidos." />
                  </ChartCard>
                  <div class="xl:col-span-3">
                     <ChartCard title="Productos más vendidos" description="Unidades en pedidos con pago aprobado.">
                        <BarList data={stats.topProductsPaid} empty="Aún no hay ventas cobradas." />
                     </ChartCard>
                  </div>
               </div>

               <h2 class="mb-3 text-sm font-bold">Agenda</h2>
               <div class="mb-8 grid gap-4 xl:grid-cols-2">
                  <ChartCard title="Citas por día de la semana" description="Citas pendientes y completadas.">
                     <ColumnChart data={stats.appointmentsByWeekday} allLabels />
                  </ChartCard>
                  <ChartCard title="Horas más solicitadas" description="Mapa de calor: día de la semana por hora.">
                     <Heatmap cells={stats.appointmentHeatmap} />
                  </ChartCard>
                  <ChartCard title="Citas por servicio" description="Número de citas pendientes y completadas.">
                     <BarList data={summary.appointmentsByService} empty="Todavía no hay citas." />
                  </ChartCard>
                  <ChartCard title="Ingresos por servicio" description="Citas completadas.">
                     <BarList data={stats.revenueByService} money empty="Aún no hay citas completadas." />
                  </ChartCard>
               </div>
            </>
         )}

         <div class="grid gap-8 xl:grid-cols-2">
            <section>
               <h3 class="mb-3 text-sm font-bold">Últimos pedidos</h3>
               {summary.recentOrders.length === 0 ? (
                  <p class="text-xs text-muted-foreground">Todavía no hay pedidos.</p>
               ) : (
                  <DataTable>
                     <thead>
                        <tr><th>#</th><th>Fecha</th><th>Cliente</th><th>Artículos</th><th>Total</th><th>Estado</th></tr>
                     </thead>
                     <tbody>
                        {summary.recentOrders.map((order) => (
                           <tr>
                              <td><a href={`/dashboard/pedidos/${order.id}`} class="font-bold underline">{order.id}</a></td>
                              <td>{formatDate(order.date)}</td>
                              <td>{order.customer.name}</td>
                              <td>{orderUnits(order)}</td>
                              <td>{formatPrice(order.total)}</td>
                              <td><StatusBadge kind="order" status={order.status} /></td>
                           </tr>
                        ))}
                     </tbody>
                  </DataTable>
               )}
            </section>

            <section>
               <h3 class="mb-3 text-sm font-bold">Próximas citas</h3>
               {summary.nextAppointments.length === 0 ? (
                  <p class="text-xs text-muted-foreground">No hay citas pendientes.</p>
               ) : (
                  <DataTable>
                     <thead>
                        <tr><th>Fecha</th><th>Hora</th><th>Cliente</th><th>Servicio</th></tr>
                     </thead>
                     <tbody>
                        {summary.nextAppointments.map((appointment) => (
                           <tr>
                              <td>{formatDate(appointment.date)}</td>
                              <td>{appointment.hour}</td>
                              <td>{appointment.customer.name}</td>
                              <td>{appointment.service.name}</td>
                           </tr>
                        ))}
                     </tbody>
                  </DataTable>
               )}
            </section>

            <section>
               <h3 class="mb-3 text-sm font-bold">Stock bajo</h3>
               {summary.lowStockProducts.length === 0 ? (
                  <p class="text-xs text-muted-foreground">Todos los productos tienen stock suficiente.</p>
               ) : (
                  <DataTable>
                     <thead>
                        <tr><th>Producto</th><th>Categoría</th><th>Stock</th></tr>
                     </thead>
                     <tbody>
                        {summary.lowStockProducts.map((product) => (
                           <tr>
                              <td><a href={`/dashboard/productos/${product.id}`} class="font-bold underline">{product.name}</a></td>
                              <td>{product.category?.name ?? '—'}</td>
                              <td class={product.stock === 0 ? 'font-bold text-destructive' : ''}>{product.stock}</td>
                           </tr>
                        ))}
                     </tbody>
                  </DataTable>
               )}
            </section>
         </div>
      </div>
   )}
</BaseLayoutAdmin>