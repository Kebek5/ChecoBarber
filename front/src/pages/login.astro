---
import { AppError } from '@/application/errors'
import { loginUser } from '@/infrastructure/container'
import { safeRedirectPath, startSession } from '@/infrastructure/auth/session'
import { translateError } from '@/i18n/errors'
import { localizeHref } from '@/i18n/routes'
import { getLang, t } from '@/i18n/ui'
import { buttonVariants } from '@/presentation/components/ui/button'
import { Input } from '@/presentation/components/ui/input'
import BaseLayout from '@/presentation/components/layout/BaseLayout.astro'
import Notice from '@/presentation/components/admin/Notice.astro'

const lang = getLang(Astro.currentLocale)

// Sin "next", se vuelve al inicio del idioma actual (/ o /en)
const safeNext = safeRedirectPath(Astro.url.searchParams.get('next'))
const next = safeNext === '/' ? localizeHref('/', lang) : safeNext

// Si ya hay sesión no tiene caso pedir credenciales otra vez
if (Astro.locals.user) return Astro.redirect(next)

let error = ''
let email = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  email = String(form.get('correo') ?? '')
  const password = String(form.get('contrasena') ?? '')

  try {
    const session = await loginUser.execute({ email, password })
    startSession(Astro.cookies, session.token)
    const role = session.user.role.toLowerCase()
    if (role !== 'admin') return Astro.redirect(next)

    return Astro.redirect('/dashboard')
  } catch (err) {
    // Solo mostramos mensajes pensados para el usuario; el resto (red, bugs) va genérico
    error = err instanceof AppError ? translateError(lang, err.message) : t(lang, 'loginErrorGeneric')
  }
}
---

<BaseLayout title={t(lang, 'loginTitle')} noindex>
  <div class="mx-auto max-w-md p-5">
    <h1 class="mb-4 text-base font-bold">{t(lang, 'loginHeading')}</h1>

    <Notice error={error} />

    <form method="post" class="flex flex-col gap-4">
      <div class="flex flex-col gap-1">
        <label for="correo" class="text-xs font-bold">{t(lang, 'fieldEmail')}</label>
        <Input id="correo" name="correo" type="email" required defaultValue={email} placeholder={t(lang, 'placeholderEmail')} autoComplete="email" />
      </div>

      <div class="flex flex-col gap-1">
        <label for="contrasena" class="text-xs font-bold">{t(lang, 'fieldPassword')}</label>
        <Input id="contrasena" name="contrasena" type="password" required autoComplete="current-password" />
      </div>

      <button type="submit" class={buttonVariants({ size: 'lg', className: 'mt-2' })}>
        {t(lang, 'loginSubmit')}
      </button>
    </form>

    <p class="mt-4 text-xs">
      {t(lang, 'loginNoAccount')}
      <a href={`${localizeHref('/registro', lang)}?next=${encodeURIComponent(next)}`} class="font-bold underline">{t(lang, 'loginRegisterLink')}</a>
    </p>
  </div>
</BaseLayout>