---
import { AppError } from '@/application/errors'
import { registerUser } from '@/infrastructure/container'
import { safeRedirectPath, startSession } from '@/infrastructure/auth/session'
import { translateError } from '@/i18n/errors'
import { localizeHref } from '@/i18n/routes'
import { getLang, t } from '@/i18n/ui'
import { buttonVariants } from '@/presentation/components/ui/button'
import { Input } from '@/presentation/components/ui/input'
import BaseLayout from '@/presentation/components/layout/BaseLayout.astro'
import Notice from '@/presentation/components/admin/Notice.astro'

const lang = getLang(Astro.currentLocale)

// Sin "next", se vuelve al inicio del idioma actual (/ o /en)
const safeNext = safeRedirectPath(Astro.url.searchParams.get('next'))
const next = safeNext === '/' ? localizeHref('/', lang) : safeNext

if (Astro.locals.user) return Astro.redirect(next)

let error = ''
let name = ''
let tel = ''
let email = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()

  name = String(form.get('nombre') ?? '')
  tel = String(form.get('telefono') ?? '')
  email = String(form.get('correo') ?? '')

  const password = String(form.get('contrasena') ?? '')
  const confirm = String(form.get('confirmar') ?? '')

  try {
    if (password !== confirm) throw new AppError(t(lang, 'passwordsMismatch'))

    const session = await registerUser.execute({ name, tel, email, password })
    startSession(Astro.cookies, session.token)
    return Astro.redirect(next)
  } catch (err) {
    // Solo mostramos mensajes pensados para el usuario; el resto (red, bugs) va genérico
    error = err instanceof AppError ? translateError(lang, err.message) : t(lang, 'registerErrorGeneric')
  }
}
---

<BaseLayout title={t(lang, 'registerTitle')} noindex>
  <div class="mx-auto max-w-md p-5">
    <h1 class="mb-4 text-base font-bold">{t(lang, 'registerHeading')}</h1>

    <Notice error={error} />

    <form method="post" class="flex flex-col gap-4">
      <div class="flex flex-col gap-1">
        <label for="nombre" class="text-xs font-bold">{t(lang, 'fieldFullName')}</label>
        <Input id="nombre" name="nombre" type="text" required defaultValue={name} placeholder={t(lang, 'placeholderName')} autoComplete="name" />
      </div>

      <div class="flex flex-col gap-1">
        <label for="telefono" class="text-xs font-bold">{t(lang, 'fieldPhone')}</label>
        <Input
          client:load id="telefono" name="telefono" type="text" inputMode="numeric"
          required maxLength={10} defaultValue={tel} placeholder="3312345678" autoComplete="tel"
          />
      </div>

      <div class="flex flex-col gap-1">
        <label for="correo" class="text-xs font-bold">{t(lang, 'fieldEmail')}</label>
        <Input id="correo" name="correo" type="email" required defaultValue={email} placeholder={t(lang, 'placeholderEmail')} autoComplete="email" />
      </div>

      <div class="flex flex-col gap-1">
        <label for="contrasena" class="text-xs font-bold">{t(lang, 'fieldPasswordMin')}</label>
        <Input id="contrasena" name="contrasena" type="password" required minLength={8} autoComplete="new-password" />
      </div>

      <div class="flex flex-col gap-1">
        <label for="confirmar" class="text-xs font-bold">{t(lang, 'fieldConfirmPassword')}</label>
        <Input id="confirmar" name="confirmar" type="password" required minLength={8} autoComplete="new-password" />
      </div>

      <button type="submit" class={buttonVariants({ size: 'lg', className: 'mt-2' })}>
        {t(lang, 'registerSubmit')}
      </button>
    </form>

    <p class="mt-4 text-xs">
      {t(lang, 'registerHaveAccount')}
      <a href={`${localizeHref('/login', lang)}?next=${encodeURIComponent(next)}`} class="font-bold underline">{t(lang, 'registerLoginLink')}</a>
    </p>
  </div>
</BaseLayout>

<script>
  const inputEl = document.getElementById('telefono') as HTMLInputElement

  if (inputEl) {
    inputEl.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement
      // Borra cualquier carácter no numérico instantáneamente al escribir o pegar
      target.value = target.value.replace(/[^0-9]/g, '')
    })
  }
</script>