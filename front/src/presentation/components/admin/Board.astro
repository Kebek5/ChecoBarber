---
import type { Category } from '@/domain/catalog/Category'
import type { Product } from '@/domain/catalog/Product'
import CategorySidebar from '../shared/CategorySidebar.astro'
import ProductCard from '../shared/ProductCard.astro'

interface Props {
   categories: Category[]
   products: Product[]
   activeCategoryId?: string | null
   search?: string
   error?: string
}

const { categories, products, activeCategoryId = null, search = '', error = '' } = Astro.props
const activeCategory = categories.find((category) => category.id === activeCategoryId)

const title = search
   ? `Resultados para “${search}”`
   : activeCategory
      ? activeCategory.name
      : 'Todos los productos'
---

{error ? (
   <div class="p-10 text-center text-destructive">
      <h3 class="font-bold">Error de conexión</h3>
      <p>{error}</p>
   </div>
) : (
   <>

      <div id="catalogo" class="mx-auto flex w-full max-w-[1600px] scroll-mt-28 flex-col items-start md:flex-row">
         <CategorySidebar
            categories={categories}
            activeCategoryId={activeCategoryId}
            allHref="/dashboard/productos"
            categoryHref={(id) => `/dashboard/productos?categoria=${id}`}
         />

         <section class="w-full min-w-0 flex-1 p-7.5">
         <div class="mb-6 flex items-center justify-between gap-5">
            <h2 class="text-2xl font-bold">{title}</h2>
         </div>

         <div class="grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-6">
            {products.length > 0 ? (
               products.map((product) => (
                  <ProductCard 
                     product={product} detailHref={`/dashboard/productos/${product.id}`} 
                     detailLabel="Administrar" showAddToCart={false}
                     />
                  )
               )
            ) : (
               <p class="col-span-full p-10 text-center text-muted-foreground">
               No se encontraron productos disponibles en esta sección.
               </p>
            )}
         </div>
         </section>

         <div class="hidden self-stretch xl:block">
         </div>
      </div>
   </>
)}