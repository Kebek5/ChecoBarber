---
import type { StatPoint } from '@/domain/admin/AdminStats'
import { OTHER_COLOR, SERIES_COLORS, fmtValue } from './chartUtils'

interface Props {
   data: StatPoint[]
   money?: boolean
   empty?: string
   centerLabel?: string
}

const { data, money = false, empty = 'Todavía no hay datos.', centerLabel = 'Total' } = Astro.props

// Máximo 5 categorías con color propio; el resto se junta en "Otros"
const sorted = data.filter((p) => p.value > 0).sort((a, b) => b.value - a.value)
const head = sorted.slice(0, SERIES_COLORS.length)
const tail = sorted.slice(SERIES_COLORS.length)
const slices = [
   ...head.map((p, i) => ({ ...p, color: SERIES_COLORS[i] })),
   ...(tail.length ? [{ label: 'Otros', value: tail.reduce((s, p) => s + p.value, 0), color: OTHER_COLOR }] : []),
]
const total = slices.reduce((s, p) => s + p.value, 0)

// circunferencia = 100 unidades (r = 100 / 2π); los cortes dejan un espacio de 0.8 como separador
const R = 15.9155
const GAP = slices.length > 1 ? 0.8 : 0
let acc = 0
const arcs = slices.map((s) => {
   const pct = (s.value / total) * 100
   const arc = { ...s, pct, dash: Math.max(pct - GAP, 0.01), offset: -acc }
   acc += pct
   return arc
})
---

{total === 0 ? (
   <p class="py-10 text-center text-xs text-muted-foreground">{empty}</p>
) : (
   <div class="flex flex-wrap items-center gap-6">
      <svg viewBox="0 0 42 42" class="size-40 shrink-0" role="img" aria-label={`Gráfica de dona. ${centerLabel}: ${fmtValue(total, money)}`}>
         <g transform="rotate(-90 21 21)">
            {arcs.map((a) => (
               <circle cx="21" cy="21" r={R} fill="none" style={`stroke:${a.color}`} stroke-width="5.5" stroke-dasharray={`${a.dash} ${100 - a.dash}`} stroke-dashoffset={a.offset}>
                  <title>{a.label}: {fmtValue(a.value, money)} ({a.pct.toFixed(0)}%)</title>
               </circle>
            ))}
         </g>
         <text x="21" y="20.5" text-anchor="middle" class="fill-foreground" font-size="5" font-weight="700">{fmtValue(total, money)}</text>
         <text x="21" y="26" text-anchor="middle" class="fill-muted-foreground" font-size="2.6">{centerLabel}</text>
      </svg>
      <ul class="flex min-w-40 flex-1 flex-col gap-2 text-xs">
         {arcs.map((a) => (
            <li class="flex items-center gap-2">
               <span class="inline-block size-2.5 shrink-0" style={`background:${a.color}`}></span>
               <span class="flex-1 truncate">{a.label}</span>
               <strong>{fmtValue(a.value, money)}</strong>
               <span class="w-9 text-right text-muted-foreground">{a.pct.toFixed(0)}%</span>
            </li>
         ))}
      </ul>
   </div>
)}
