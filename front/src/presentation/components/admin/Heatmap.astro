---
import type { HeatCell } from '@/domain/admin/AdminStats'

interface Props {
   cells: HeatCell[]
   empty?: string
}

const { cells, empty = 'Todavía no hay citas.' } = Astro.props

const DAYS = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom']
const max = Math.max(...cells.map((c) => c.count), 0)

// Horario de la barbería 10:00–19:00; se amplía si hay citas fuera de él
const hours = cells.map((c) => c.hour)
const first = Math.min(10, ...hours)
const last = Math.max(18, ...hours)
const columns = Array.from({ length: last - first + 1 }, (_, i) => first + i)
// Domingo (cerrado) solo aparece si tiene citas
const rows = DAYS.map((label, i) => ({ label, weekday: i + 1 })).filter((d) => d.weekday < 7 || cells.some((c) => c.weekday === 7))

const countAt = (weekday: number, hour: number) =>
   cells.find((c) => c.weekday === weekday && c.hour === hour)?.count ?? 0
const fill = (count: number) =>
   count === 0
      ? 'background:var(--viz-grid);opacity:0.55'
      : `background:color-mix(in oklab, var(--viz-1) ${Math.round(18 + (82 * count) / max)}%, var(--viz-surface))`
---

{max === 0 ? (
   <p class="py-10 text-center text-xs text-muted-foreground">{empty}</p>
) : (
   <figure role="img" aria-label="Mapa de calor de citas por día de la semana y hora">
      <div class="grid gap-0.5" style={`grid-template-columns: 2.25rem repeat(${columns.length}, minmax(0, 1fr))`}>
         <span></span>
         {columns.map((h) => <span class="text-center text-[10px] text-muted-foreground">{h}h</span>)}
         {rows.map((row) => (
            <>
               <span class="self-center text-[11px] text-muted-foreground">{row.label}</span>
               {columns.map((h) => {
                  const count = countAt(row.weekday, h)
                  return (
                     <div class="h-7" style={fill(count)} title={`${row.label} ${String(h).padStart(2, '0')}:00 — ${count} ${count === 1 ? 'cita' : 'citas'}`}></div>
                  )
               })}
            </>
         ))}
      </div>
      <div class="mt-3 flex items-center justify-end gap-1.5 text-[10px] text-muted-foreground">
         <span>Menos</span>
         {[0.2, 0.45, 0.7, 1].map((f) => (
            <span class="inline-block size-3" style={`background:color-mix(in oklab, var(--viz-1) ${Math.round(18 + 82 * f)}%, var(--viz-surface))`}></span>
         ))}
         <span>Más (máx. {max})</span>
      </div>
   </figure>
)}
