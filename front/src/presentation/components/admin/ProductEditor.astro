---
import type { Category } from '@/domain/catalog/Category'
import type { ProductFormValues } from '../lib/productForm'
import { buttonVariants } from '@/presentation/components/ui/button'
import { Input } from '@/presentation/components/ui/input'

interface Props {
   categories: Category[]
   values: ProductFormValues
   submitLabel?: string
}

const { categories, values, submitLabel = 'Guardar' } = Astro.props

const areaClass =
   'w-full border bg-transparent px-2.5 py-1.5 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring'
---

<form method="post" enctype="multipart/form-data" class="flex max-w-xl flex-col gap-4">
   <input type="hidden" name="intent" value="save" />

   <div class="flex flex-col gap-1">
      <label for="name" class="text-xs font-bold">Nombre</label>
      <Input id="name" name="name" required minLength={3} defaultValue={values.name} />
   </div>

   <div class="flex flex-col gap-1">
      <label for="description" class="text-xs font-bold">Descripción</label>
      <textarea id="description" name="description" required rows="4" class={areaClass}>{values.description}</textarea>
   </div>

   <div class="grid grid-cols-2 gap-4">
      <div class="flex flex-col gap-1">
         <label for="price" class="text-xs font-bold">Precio (MXN)</label>
         <Input id="price" name="price" type="number" step="0.01" min="0.01" required defaultValue={values.price} />
      </div>
      <div class="flex flex-col gap-1">
         <label for="stock" class="text-xs font-bold">Stock</label>
         <Input id="stock" name="stock" type="number" step="1" min="0" required defaultValue={values.stock} />
      </div>
   </div>

   <div class="flex flex-col gap-1">
      <label for="categoryId" class="text-xs font-bold">Categoría</label>
      <select id="categoryId" name="categoryId" required class={areaClass}>
         <option value="" selected={values.categoryId === ''} disabled>Elige una categoría</option>
         {categories.map((category) => (
            <option value={category.id} selected={values.categoryId === category.id}>{category.name}</option>
         ))}
      </select>
   </div>

      <div class="flex flex-col gap-2">
         <label for="imageFile" class="text-xs font-bold">Imagen del producto</label>
         {values.img && (
            <img src={values.img} alt="Imagen actual" class="h-32 w-32 border object-cover" />
         )}
         <input
            id="imageFile"
            name="imageFile"
            type="file"
            accept="image/jpeg,image/png,image/webp,image/avif"
            class="text-sm"
         />
         <p class="text-xs text-muted-foreground">
            JPG, PNG, WebP o AVIF, máximo 5 MB. Si no eliges archivo se conserva la imagen actual.
         </p>
         <input type="hidden" name="img" value={values.img} />
      </div>

   <div class="flex gap-2">
      <button type="submit" class={buttonVariants({ size: 'lg' })}>{submitLabel}</button>
      <a href="/dashboard/productos" class={buttonVariants({ variant: 'outline', size: 'lg' })}>Cancelar</a>
   </div>
</form>