---
import type { Category } from '@/domain/catalog/Category'
import type { Product } from '@/domain/catalog/Product'
import { getLang, t } from '@/i18n/ui'
import Hero from '@/presentation/components/layout/Hero.astro'
import CategorySidebar from '../shared/CategorySidebar.astro'
import MiniCart from '@/presentation/components/customer/MiniCart'
import ProductCard from '../shared/ProductCard.astro'

interface Props {
  categories: Category[]
  products: Product[]
  activeCategoryId?: string | null
  search?: string
  error?: string
}

const lang = getLang(Astro.currentLocale)
const { categories, products, activeCategoryId = null, search = '', error = '' } = Astro.props
const activeCategory = categories.find((category) => category.id === activeCategoryId)

const title = search
  ? t(lang, 'shopResults', { q: search })
  : activeCategory
    ? activeCategory.name
    : t(lang, 'shopAll')

const isHome = !activeCategoryId && !search
const Title = isHome ? 'h2' : 'h1'
---

{error ? (
  <div class="p-6 text-center text-destructive md:p-10">
    <h3 class="font-bold">{t(lang, 'shopError')}</h3>
    <p>{error}</p>
  </div>
) : (
  <>
    <Hero asH1={isHome} />

    <div id="catalogo" class="mx-auto flex w-full max-w-[1600px] scroll-mt-28 flex-col items-start md:flex-row">
      <CategorySidebar categories={categories} activeCategoryId={activeCategoryId} />

      <section class="w-full min-w-0 flex-1 p-4 md:p-7.5">
        <div class="mb-6 flex items-center justify-between gap-5">
          <Title class="text-xl font-bold md:text-2xl">{title}</Title>
          {!isHome && <h2 class="sr-only">{t(lang, 'shopAvailable')}</h2>}
        </div>

        <div id="product-grid" class="grid grid-cols-1 gap-4 md:grid-cols-[repeat(auto-fill,minmax(240px,1fr))] md:gap-6">
          {products.length > 0 ? (
            products.map((product) => <ProductCard product={product} />)
          ) : (
            <p class="col-span-full p-6 text-center text-muted-foreground md:p-10">
              {t(lang, 'shopEmpty')}
            </p>
          )}
        </div>
      </section>

      <div class="hidden self-stretch xl:block">
        <MiniCart client:only="react" lang={lang} />
      </div>
    </div>
  </>
)}