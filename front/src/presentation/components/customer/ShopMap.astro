---
import { PUBLIC_SHOP_MAP_QUERY } from 'astro:env/client'
import { getLang, t } from '@/i18n/ui'

const lang = getLang(Astro.currentLocale)

// Mapa embebido sin API key: https://www.google.com/maps?q=...&output=embed
const query = PUBLIC_SHOP_MAP_QUERY?.trim() || 'ChecoBarber'
const q = encodeURIComponent(query)
const embed = `https://www.google.com/maps?q=${q}&hl=${lang}&z=16&output=embed`
const directions = `https://www.google.com/maps/dir/?api=1&destination=${q}`
const openMap = `https://www.google.com/maps/search/?api=1&query=${q}`
---

<section class="flex flex-col gap-3">
   <h2 class="text-lg font-bold">{t(lang, 'mapTitle')}</h2>
   <p class="text-xs text-muted-foreground">{query}</p>
   <iframe
      title={t(lang, 'mapIframeTitle')}
      src={embed}
      class="h-80 w-full border"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
   ></iframe>
   <div class="flex flex-wrap gap-4 text-xs font-bold">
      <a href={directions} target="_blank" rel="noopener noreferrer" class="underline">{t(lang, 'mapDirections')}</a>
      <a href={openMap} target="_blank" rel="noopener noreferrer" class="underline">{t(lang, 'mapOpen')}</a>
   </div>
</section>