---
import { PUBLIC_SHOP_MAP_QUERY } from 'astro:env/client'

// Mapa embebido sin API key: https://www.google.com/maps?q=...&output=embed.
// Antes dependía de la Embed API (PUBLIC_GOOGLE_MAPS_KEY): sin llave, o con una llave sin la API habilitada
// o con restricciones de dominio, el recuadro salía vacío o con error.
const query = PUBLIC_SHOP_MAP_QUERY?.trim() || 'ChecoBarber'
const q = encodeURIComponent(query)
const embed = `https://www.google.com/maps?q=${q}&hl=es&z=16&output=embed`
const directions = `https://www.google.com/maps/dir/?api=1&destination=${q}`
const openMap = `https://www.google.com/maps/search/?api=1&query=${q}`
---

<section class="flex flex-col gap-3">
   <h2 class="text-lg font-bold">Dónde estamos</h2>
   <p class="text-xs text-muted-foreground">{query}</p>
   <iframe
      title="Ubicación de ChecoBarber"
      src={embed}
      class="h-80 w-full border"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
   ></iframe>
   <div class="flex gap-4 text-xs font-bold">
      <a href={directions} target="_blank" rel="noopener noreferrer" class="underline">Cómo llegar</a>
      <a href={openMap} target="_blank" rel="noopener noreferrer" class="underline">Abrir en Google Maps</a>
   </div>
</section>
