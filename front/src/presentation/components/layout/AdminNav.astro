---
import {
   CalendarBlankIcon,
   CreditCardIcon,
   PackageIcon,
   ReceiptIcon,
   SquaresFourIcon,
   UsersIcon,
} from '@phosphor-icons/react/dist/ssr'

const pathname = Astro.url.pathname.replace(/\/$/, '')

const items = [
   { href: '/dashboard', label: 'Resumen', Icon: SquaresFourIcon, exact: true },
   { href: '/dashboard/productos', label: 'Productos', Icon: PackageIcon },
   { href: '/dashboard/pedidos', label: 'Pedidos', Icon: ReceiptIcon },
   { href: '/dashboard/citas', label: 'Citas', Icon: CalendarBlankIcon },
   { href: '/dashboard/clientes', label: 'Clientes', Icon: UsersIcon },
   { href: '/dashboard/pagos', label: 'Cobros', Icon: CreditCardIcon },
]

const isActive = (href: string, exact = false) =>
   exact ? pathname === href : pathname === href || pathname.startsWith(`${href}/`)

// Mismo estilo que el Sidebar de la tienda
const linkClass = (active: boolean) =>
   `flex w-full items-center gap-2 px-2.5 py-1.5 text-left text-xs hover:bg-muted ${active ? 'bg-muted font-bold' : ''}`
---

<aside class="w-full shrink-0 border-b p-4 md:w-52 md:border-r md:border-b-0">
   <h3 class="mb-3 text-sm font-bold">Panel</h3>

   <ul class="flex flex-row flex-wrap gap-1 md:flex-col">
      {items.map(({ href, label, Icon, exact }) => (
         <li>
         <a href={href} class={linkClass(isActive(href, exact))} aria-current={isActive(href, exact) ? 'page' : undefined}>
            <Icon />
            {label}
         </a>
         </li>
      ))}
   </ul>
</aside>