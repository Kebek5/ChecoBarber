---
import { FacebookLogoIcon, GithubLogoIcon, InstagramLogoIcon, LinkedinLogoIcon } from '@phosphor-icons/react/dist/ssr'
import { Separator } from '@/presentation/components/ui/separator'
import { localizeHref } from '@/i18n/routes'
import { getLang, t } from '@/i18n/ui'

const user = Astro.locals.user
const lang = getLang(Astro.currentLocale)
const href = (path: string) => localizeHref(path, lang)

const socials = [
  { label: 'Instagram', href: '#', Icon: InstagramLogoIcon },
  { label: 'Facebook', href: '#', Icon: FacebookLogoIcon },
  { label: 'LinkedIn', href: '#', Icon: LinkedinLogoIcon },
  { label: 'GitHub', href: '#', Icon: GithubLogoIcon },
]

const sitemap = [
  { label: t(lang, 'footerShop'), href: href('/') },
  { label: t(lang, 'navBook'), href: href('/citas') },
  { label: t(lang, 'footerCart'), href: href('/carrito') },
  ...(user
    ? []
    : [
        { label: t(lang, 'navLogin'), href: href('/login') },
        { label: t(lang, 'navRegister'), href: href('/registro') },
      ]),
]
---

<footer id="contacto" class="w-full bg-footer pt-12 pr-[max(1.5rem,env(safe-area-inset-right))] pb-[calc(3rem_+_env(safe-area-inset-bottom,0px))] pl-[max(1.5rem,env(safe-area-inset-left))] text-footer-foreground md:pr-[max(3rem,env(safe-area-inset-right))] md:pl-[max(3rem,env(safe-area-inset-left))]">
  <div class="mx-auto grid max-w-[1600px] gap-10 md:grid-cols-[2fr_3fr] md:items-start">
    <section class="flex flex-col items-start justify-center gap-2">
      <img src="/logo-sm.webp" alt={t(lang, 'logoAlt')} width="72" height="72" loading="lazy" decoding="async" class="mb-2 w-18 object-contain" />
      <div class="flex items-center gap-2">
        {socials.map(({ label, href, Icon }) => (
          <a
            href={href}
            aria-label={label}
            class="flex size-8 items-center justify-center rounded-md border border-footer-foreground p-1.5 transition-opacity hover:opacity-60"
          >
            <Icon size={20} />
          </a>
        ))}
      </div>
    </section>

    <section class="grid grid-cols-1 gap-8 sm:grid-cols-2">
      <div class="flex min-w-0 flex-col items-start gap-2">
        <h3 class="mb-3 text-xl font-bold">{t(lang, 'footerContact')}</h3>
        <a href="tel:+523337296008" class="transition-opacity hover:opacity-60">+52 333 729 6008</a>
        <a href="mailto:a23300700@ceti.mx" class="break-all transition-opacity hover:opacity-60">a23300700@ceti.mx</a>
        <span class="max-w-55 text-pretty">Checo Barber. Haircuts &amp; Shaves. Est. 2025</span>
      </div>

      <div class="flex min-w-0 flex-col items-start">
        <h3 class="mb-3 text-xl font-bold">{t(lang, 'footerSitemap')}</h3>
        <ul class="flex flex-col gap-2">
          {sitemap.map((item) => (
            <li>
              <a href={item.href} class="transition-opacity hover:opacity-60">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <Separator className="mx-auto mt-10 max-w-[1600px] bg-footer-foreground/20" />
  <p class="mt-5 text-center text-xs text-footer-foreground/70">
    © {new Date().getFullYear()} ChecoBarber
  </p>
</footer>