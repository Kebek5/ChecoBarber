---
import { Badge } from '@/presentation/components/ui/badge'
import { buttonVariants } from '@/presentation/components/ui/button'

interface Props {
   asH1?: boolean
}
const { asH1 = true } = Astro.props
const Heading = asH1 ? 'h1' : 'p'
---

<section class="mx-auto flex min-h-130 w-full max-w-[1600px] flex-col items-center justify-between gap-12 overflow-hidden px-6 py-16 md:flex-row md:px-15 md:py-17.5">
   <div class="max-w-175 flex-1">
      <Badge variant="outline" className="mb-4.5 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[2px]">
         Haircuts &amp; Shaves
      </Badge>
      <Heading class="mb-5 text-[clamp(42px,6vw,76px)] leading-[0.98] font-bold tracking-[-2px]">
         Chequito Barber.<br />
         Cuida cada detalle.
      </Heading>
      <p class="mb-7.5 max-w-140 text-[17px] leading-relaxed text-muted-foreground">
         Descubre nuestra selección de productos para cabello y barba y lleva tu rutina de cuidado
         al siguiente nivel.
      </p>
      <div class="flex flex-wrap items-center gap-3">
         <a href="#catalogo" class={buttonVariants({ size: 'lg', className: 'min-w-37.5' })}>Ver productos</a>
         <a href="#contacto" class={buttonVariants({ variant: 'outline', size: 'lg', className: 'min-w-37.5' })}>Conoce más</a>
      </div>
   </div>

   <div class="relative flex size-105 max-w-full shrink-0 items-center justify-center">
      <img
         src="/logo-hero.webp"
         alt="Logo de ChecoBarber"
         width="340"
         height="340"
         fetchpriority="high"
         decoding="async"
         class="size-85 max-w-[85%] rounded-full bg-[#fde2be] object-cover object-[center_-10px] shadow-[0_20px_40px_#2224]"
      />
      <div class="absolute right-0 bottom-8.75 flex size-27.5 flex-col items-center justify-center rounded-full border border-foreground bg-background shadow-[0_8px_20px_#2223]">
         <strong class="text-2xl">Carpe</strong>
         <span class="text-base text-muted-foreground uppercase">diem</span>
      </div>
   </div>
</section>