---
import { Badge } from '@/presentation/components/ui/badge'
import { buttonVariants } from '@/presentation/components/ui/button'
import { getLang, t } from '@/i18n/ui'

interface Props {
   asH1?: boolean
}
const { asH1 = true } = Astro.props
const Heading = asH1 ? 'h1' : 'p'
const lang = getLang(Astro.currentLocale)
---

<section class="mx-auto flex min-h-[min(32.5rem,100dvh)] w-full max-w-[1600px] flex-col items-center justify-between gap-8 overflow-hidden px-6 py-10 md:flex-row md:gap-12 md:px-15 md:py-17.5 max-md:landscape:flex-row max-md:landscape:py-6">
   <div class="max-w-175 min-w-0 flex-1">
      <Badge variant="outline" className="mb-4.5 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[2px]">
         {t(lang, 'heroBadge')}
      </Badge>
      <Heading class="mb-5 text-[clamp(36px,6vw,76px)] leading-[0.98] font-bold tracking-[-2px]">
         {t(lang, 'heroTitle1')}<br />
         {t(lang, 'heroTitle2')}
      </Heading>
      <p class="mb-7.5 max-w-140 text-base leading-relaxed text-muted-foreground md:text-[17px]">
         {t(lang, 'heroText')}
      </p>
      <div class="flex flex-wrap items-center gap-3">
         <a href="#catalogo" class={buttonVariants({ size: 'lg', className: 'min-w-37.5' })}>{t(lang, 'heroShop')}</a>
         <a href="#contacto" class={buttonVariants({ variant: 'outline', size: 'lg', className: 'min-w-37.5' })}>{t(lang, 'heroMore')}</a>
      </div>
   </div>

   <div class="relative flex size-64 shrink-0 items-center justify-center xs:size-72 md:size-105 max-md:landscape:size-52">
      <img
         src="/logo-hero.webp"
         alt={t(lang, 'heroLogoAlt')}
         width="340"
         height="340"
         fetchpriority="high"
         decoding="async"
         class="size-52 rounded-full bg-[#fde2be] object-cover object-[center_-10px] shadow-[0_20px_40px_#2224] xs:size-60 md:size-85 max-md:landscape:size-40"
      />
      <div class="absolute right-0 bottom-4 flex size-22 flex-col items-center justify-center rounded-full border border-foreground bg-background shadow-[0_8px_20px_#2223] md:bottom-8.75 md:size-27.5">
         <strong class="text-lg md:text-2xl">Carpe</strong>
         <span class="text-xs text-muted-foreground uppercase md:text-base">diem</span>
      </div>
   </div>
</section>