---
import type { Category } from '@/domain/catalog/Category'

interface Props {
  categories: Category[]
  activeCategoryId?: string | null
  allHref?: string
  categoryHref?: (id: string) => string
}

const {
  categories,
  activeCategoryId = null,
  allHref = '/',
  categoryHref = (id: string) => `/categoria/${id}`,
} = Astro.props

const linkClass = (active: boolean) =>
  `block w-full rounded-lg px-4 py-2.5 text-left text-sm font-bold transition-colors hover:bg-[#dcdcdc] ${active ? 'bg-[#dcdcdc]' : ''}`
---

<aside class="flex w-full shrink-0 flex-col items-start gap-5 px-5 py-7.5 md:w-57.5 md:min-w-65">
  <h2 class="w-full text-xl font-bold tracking-[2px]">Categorías</h2>
  <ul class="flex w-full flex-col">
    <li>
      <a href={allHref} class={linkClass(activeCategoryId === null)}>Todas las categorías</a>
    </li>
    {categories.map((category) => (
      <li>
        {/* Si ya está activa, al volver a darle clic se quita el filtro */}
        <a
          href={activeCategoryId === category.id ? allHref : categoryHref(category.id)}
          class={linkClass(activeCategoryId === category.id)}
        >
          {category.name}
        </a>
      </li>
    ))}
  </ul>
</aside>