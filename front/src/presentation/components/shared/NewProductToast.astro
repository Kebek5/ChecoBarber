---
// Se lee del esquema de astro.config (tiene valor por defecto). Con import.meta.env quedaba
// `undefined` cuando la variable no estaba en el .env y la suscripción nunca se conectaba.
import { PUBLIC_GRAPHQL_WS_URL } from 'astro:env/client'

interface Props {
  admin?: boolean
}
const { admin = false } = Astro.props
---

<div id="toast-root" data-ws={PUBLIC_GRAPHQL_WS_URL} data-admin={admin ? '1' : ''} hidden></div>
<!-- transition:persist: los avisos sobreviven al reemplazo de página que hace el catálogo en vivo -->
<div id="toast-list" transition:persist aria-live="polite" class="fixed right-4 bottom-4 z-50 flex w-72 flex-col gap-2"></div>

<script>
  import { createClient } from 'graphql-ws'
  import { navigate } from 'astro:transitions/client'

  interface NewProduct {
    id: string
    name: string
    price: number
    category: { name: string } | null
  }

  const QUERY = `subscription { productCreated { id name price category { name } } }`
  const VISIBLE_MS = 8000
  const money = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' })
  // Con ClientRouter este script se vuelve a ejecutar en cada navegación: la marca va en window
  // para tener una sola conexión por pestaña (si no, se duplican avisos y recargas).
  const flags = window as unknown as { __newProductSubscribed?: boolean }
  let queue: Promise<void> = Promise.resolve()

  // Si el cliente está viendo el catálogo, se vuelve a pedir la página y se reemplaza sin recargar
  // (conserva el scroll y el carrito). Se encadenan para que productos seguidos no se pisen.
  function refreshCatalog(): Promise<void> {
    queue = queue.then(async () => {
      if (!document.getElementById('product-grid')) return
      const y = window.scrollY
      await navigate(location.pathname + location.search, { history: 'replace' })
      window.scrollTo(0, y)
    }).catch((err) => console.error('[catálogo en vivo]', err))
    return queue
  }

  function toastList() {
    let list = document.getElementById('toast-list')
    if (!list) {
      list = document.createElement('div')
      list.id = 'toast-list'
      list.setAttribute('aria-live', 'polite')
      list.className = 'fixed right-4 bottom-4 z-50 flex w-72 flex-col gap-2'
      document.body.append(list)
    }
    return list
  }

  function show(product: NewProduct) {
    const admin = document.getElementById('toast-root')?.dataset.admin === '1'
    const list = toastList()
    list.querySelector(`[data-id="${product.id}"]`)?.remove()

    const card = document.createElement('div')
    card.dataset.id = product.id
    card.className = 'border bg-background p-3 text-xs shadow-md'

    const head = document.createElement('div')
    head.className = 'flex items-start justify-between gap-2'
    const title = document.createElement('span')
    title.className = 'font-bold'
    title.textContent = 'Nuevo producto'
    const close = document.createElement('button')
    close.type = 'button'
    close.textContent = '✕'
    close.setAttribute('aria-label', 'Cerrar aviso')
    close.className = 'text-muted-foreground hover:text-foreground'
    close.addEventListener('click', () => card.remove())
    head.append(title, close)

    const name = document.createElement('p')
    name.className = 'mt-1'
    name.textContent = product.name

    const meta = document.createElement('p')
    meta.className = 'text-muted-foreground'
    meta.textContent = `${product.category?.name ?? 'Sin categoría'} · ${money.format(product.price)}`

    const link = document.createElement('a')
    link.className = 'mt-2 inline-block font-bold underline'
    link.href = admin ? `/dashboard/productos/${product.id}` : `/producto/${product.id}`
    link.textContent = admin ? 'Administrar' : 'Ver producto'

    card.append(head, name, meta, link)
    list.prepend(card)
    while (list.children.length > 3) list.lastElementChild?.remove()
    setTimeout(() => card.remove(), VISIBLE_MS)
  }

  function init() {
    if (flags.__newProductSubscribed) return
    const url = document.getElementById('toast-root')?.dataset.ws
    if (!url) return
    flags.__newProductSubscribed = true

    // graphql-ws solo reintenta por defecto cuando el servidor cierra una conexión ya abierta.
    // Si el backend aún no estaba arriba (ERR_CONNECTION_REFUSED), daba por perdida la suscripción
    // para siempre. Con shouldRetry reintenta con espera creciente hasta que el servidor responda.
    createClient({ url, retryAttempts: Infinity, shouldRetry: () => true }).subscribe<{ productCreated: NewProduct }>(
      { query: QUERY },
      {
        next: ({ data }) => {
          if (!data?.productCreated) return
          show(data.productCreated)
          void refreshCatalog()
        },
        error: (err: unknown) => console.warn('[suscripción productCreated] se detuvo:', err),
        complete: () => {},
      }
    )
  }

  // init()
  // document.addEventListener('astro:page-load', init)

  // Abre el WebSocket cuando el navegador está libre, para no competir con el render inicial
  const whenIdle = (fn: () => void) =>
    'requestIdleCallback' in window ? window.requestIdleCallback(fn, { timeout: 4000 }) : setTimeout(fn, 2000)

  whenIdle(init)
  document.addEventListener('astro:page-load', () => whenIdle(init))
</script>