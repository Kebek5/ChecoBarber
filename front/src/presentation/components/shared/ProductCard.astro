---
import type { Product } from '@/domain/catalog/Product'
import { buttonVariants } from '@/presentation/components/ui/button'
import AddToCartButton from '@/presentation/components/customer/AddToCartButton'
import { resizeImage } from '@/presentation/components/lib/image'
import { localizeHref } from '@/i18n/routes'
import { getLang, t } from '@/i18n/ui'

interface Props {
    product: Product
    detailHref?: string
    detailLabel?: string
    showAddToCart?: boolean
}

const lang = getLang(Astro.currentLocale)

const {
    product,
    detailHref = localizeHref(`/producto/${product.id}`, lang),
    showAddToCart = true,
    detailLabel = t(lang, 'viewDetail')
} = Astro.props
---

<div class="flex w-full min-w-0 flex-col justify-between border p-4">

    <div>

        <div class="relative mb-2.5 flex h-35 items-center justify-center bg-muted">
            <span class="text-xs text-muted-foreground" aria-hidden="true">🖼️ {t(lang, 'noImage')}</span>

            {product.img && (
                <img
                    src={resizeImage(product.img, 520)}
                    alt={product.name}
                    width="228"
                    height="140"
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 size-full bg-muted object-contain"
                    onerror="this.remove()"
                />
            )}
        </div>

        <h3 class="mt-2.5 mb-1 text-sm">{product.name}</h3>
        <p class="mb-4 font-bold">${product.price.toFixed(2)}</p>
    </div>

    <div class="flex flex-col gap-1.5">

        <a href={detailHref} class={buttonVariants({ variant: 'outline', size: 'lg' })}>{detailLabel}</a>

        {showAddToCart && (
            <AddToCartButton
                client:visible
                label={t(lang, 'add')}
                product={{
                    id: product.id,
                    name: product.name,
                    price: product.price,
                    img: product.img
                }}
            />
        )}
    </div>
</div>