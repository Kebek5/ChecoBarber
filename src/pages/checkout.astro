---
import Checkout from '@/presentation/components/templates/Checkout'
import BaseLayout from '@/presentation/components/layout/BaseLayout.astro'

const user = Astro.locals.user
---

<BaseLayout title="Checkout | ChecoBarber">
  <Checkout client:only="react" userName={user?.name ?? ''} userEmail={user?.email ?? ''} userTel={user?.tel ?? ''} />
</BaseLayout>