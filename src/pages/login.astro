---
import { AppError } from '@/application/errors'
import { loginUser } from '@/infrastructure/container'
import { safeRedirectPath, startSession } from '@/infrastructure/auth/session'
import { buttonVariants } from '@/presentation/components/ui/button'
import { Input } from '@/presentation/components/ui/input'
import BaseLayout from '@/presentation/components/layout/BaseLayout.astro'

const next = safeRedirectPath(Astro.url.searchParams.get('next'))

// Si ya hay sesión no tiene caso pedir credenciales otra vez
if (Astro.locals.user) return Astro.redirect(next)

let error = ''
let email = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  email = String(form.get('correo') ?? '')
  const password = String(form.get('contrasena') ?? '')

  try {
    const session = await loginUser.execute({ email, password })
    startSession(Astro.cookies, session.token)
    const role = session.user.role.toLowerCase();
    if(role !== 'admin')
      return Astro.redirect(next)

    return Astro.redirect('/dashboard');

  } catch (err) {
    // Solo mostramos mensajes pensados para el usuario; el resto (red, bugs) va genérico
    error = err instanceof AppError ? err.message : 'No se pudo iniciar sesión. Intenta de nuevo.'
  }
}
---

<BaseLayout title="Iniciar sesión | ChecoBarber">
  <div class="mx-auto max-w-md p-5">
    <h2 class="mb-4 text-base font-bold">Iniciar sesión</h2>

    {error && (
      <div class="mb-4 border border-destructive/40 bg-destructive/10 p-2.5 text-destructive">
        <strong>Error:</strong> {error}
      </div>
    )}

    <form method="post" class="flex flex-col gap-4">
      <div class="flex flex-col gap-1">
        <label for="correo" class="text-xs font-bold">Correo electrónico</label>
        <Input id="correo" name="correo" type="email" required defaultValue={email} placeholder="correo@ejemplo.com" autoComplete="email" />
      </div>

      <div class="flex flex-col gap-1">
        <label for="contrasena" class="text-xs font-bold">Contraseña</label>
        <Input id="contrasena" name="contrasena" type="password" required autoComplete="current-password" />
      </div>

      <button type="submit" class={buttonVariants({ size: 'lg', className: 'mt-2' })}>
        Entrar
      </button>
    </form>

    <p class="mt-4 text-xs">
      ¿No tienes cuenta?
      <a href={`/registro?next=${encodeURIComponent(next)}`} class="font-bold underline">Regístrate</a>
    </p>
  </div>
</BaseLayout>