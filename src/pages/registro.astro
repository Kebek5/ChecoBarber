---
import { AppError } from '@/application/errors'
import { registerUser } from '@/infrastructure/container'
import { safeRedirectPath, startSession } from '@/infrastructure/auth/session'
import { buttonVariants } from '@/presentation/components/ui/button'
import { Input } from '@/presentation/components/ui/input'
import BaseLayout from '@/presentation/components/layout/BaseLayout.astro'

const next = safeRedirectPath(Astro.url.searchParams.get('next'))

if (Astro.locals.user) return Astro.redirect(next)

let error = ''
let name = ''
let tel = ''
let email = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  name = String(form.get('nombre') ?? '')
  tel = String(form.get('telefono') ?? '')
  email = String(form.get('correo') ?? '')
  const password = String(form.get('contrasena') ?? '')
  const confirm = String(form.get('confirmar') ?? '')

  try {
    if (password !== confirm) throw new Error('Las contraseñas no coinciden.')

    const session = await registerUser.execute({ name, tel, email, password })
    startSession(Astro.cookies, session.token)
    return Astro.redirect(next)
  } catch (err) {
    // Solo mostramos mensajes pensados para el usuario; el resto (red, bugs) va genérico
    error = err instanceof AppError ? err.message : 'No se pudo crear la cuenta. Intenta de nuevo.'
  }
}
---

<BaseLayout title="Registro | ChecoBarber">
  <div class="mx-auto max-w-md p-5">
    <h2 class="mb-4 text-base font-bold">Crear cuenta</h2>

    {error && (
      <div class="mb-4 border border-destructive/40 bg-destructive/10 p-2.5 text-destructive">
        <strong>Error:</strong> {error}
      </div>
    )}

    <form method="post" class="flex flex-col gap-4">
      <div class="flex flex-col gap-1">
        <label for="nombre" class="text-xs font-bold">Nombre Completo</label>
        <Input id="nombre" name="nombre" type="text" required defaultValue={name} placeholder="Juan Pérez" autoComplete="name" />
      </div>

      <div class="flex flex-col gap-1">
        <label for="telefono" class="text-xs font-bold">Teléfono (10 dígitos)</label>
        <Input id="telefono" name="telefono" type="tel" inputMode="numeric" required maxLength={10} defaultValue={tel} placeholder="3312345678" autoComplete="tel" />
      </div>

      <div class="flex flex-col gap-1">
        <label for="correo" class="text-xs font-bold">Correo electrónico</label>
        <Input id="correo" name="correo" type="email" required defaultValue={email} placeholder="correo@ejemplo.com" autoComplete="email" />
      </div>

      <div class="flex flex-col gap-1">
        <label for="contrasena" class="text-xs font-bold">Contraseña (mínimo 8 caracteres)</label>
        <Input id="contrasena" name="contrasena" type="password" required minLength={8} autoComplete="new-password" />
      </div>

      <div class="flex flex-col gap-1">
        <label for="confirmar" class="text-xs font-bold">Confirmar contraseña</label>
        <Input id="confirmar" name="confirmar" type="password" required minLength={8} autoComplete="new-password" />
      </div>

      <button type="submit" class={buttonVariants({ size: 'lg', className: 'mt-2' })}>
        Crear cuenta
      </button>
    </form>

    <p class="mt-4 text-xs">
      ¿Ya tienes cuenta?
      <a href={`/login?next=${encodeURIComponent(next)}`} class="font-bold underline">Inicia sesión</a>
    </p>
  </div>
</BaseLayout>