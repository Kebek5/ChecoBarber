---
import '@/styles/global.css'
import Footer from '@/presentation/components/layout/Footer.astro'
import TopBarAdmin from './TopBarAdmin.astro'

interface Props {
   title?: string
}

const { title = 'ChecoBarber' } = Astro.props
---

<!doctype html>
<html lang="es">
   <head>
      <meta charset="utf-8" />
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <link rel="icon" href="/favicon.ico" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <meta name="generator" content={Astro.generator} />
      <title>{title}</title>
   </head>
   <body class="flex min-h-screen flex-col">
      <TopBarAdmin />
      <main class="flex-1">
         <slot />
      </main>
      <Footer />
   </body>
</html>