---
import CartBadge from '@/presentation/components/layout/CartBadge'
import { buttonVariants } from '@/presentation/components/ui/button'

const user = Astro.locals.user
---

<header class="border-b">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
    <a href="/" class="text-sm font-bold">ChecoBarber</a>

    <nav class="flex items-center gap-4 text-xs">
      <CartBadge client:only="react">
        <span slot="fallback">🛒 Carrito</span>
      </CartBadge>

      {user ? (
        <>
          <span>Hola, {user.name}</span>
          <form method="post" action="/salir">
            <button type="submit" class={buttonVariants({ variant: 'outline', size: 'sm' })}>
              Cerrar sesión
            </button>
          </form>
        </>
      ) : (
        <>
          <a href="/login" class={buttonVariants({ variant: 'ghost', size: 'sm' })}>Iniciar sesión</a>
          <a href="/registro" class={buttonVariants({ variant: 'default', size: 'sm' })}>Registrarse</a>
        </>
      )}
    </nav>
  </div>
</header>