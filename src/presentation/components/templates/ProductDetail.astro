---
import type { Product } from '@/domain/catalog/Product'
import AddToCartButton from '@/presentation/components/templates/AddToCartButton'
import { buttonVariants } from '@/presentation/components/ui/button'

interface Props {
  product: Product
}

const { product } = Astro.props
const inStock = product.stock > 0
---

<div class="mx-auto max-w-3xl p-10">
  <a href="/" class={buttonVariants({ variant: 'outline', className: 'mb-5' })}>
    ⬅ Volver al Catálogo
  </a>

  <div class="flex gap-10 border p-5">
    <div class="relative flex size-[300px] shrink-0 items-center justify-center bg-muted">
      <span class="text-xs text-muted-foreground">🖼️ Sin Imagen</span>
      {product.img && (
        <img
          src={product.img}
          alt={product.name}
          class="absolute inset-0 size-full bg-muted object-contain"
          onerror="this.remove()"
        />
      )}
    </div>

    <div class="flex-1">
      <h2 class="text-lg font-bold">{product.name}</h2>
      {product.category && (
        <span class="bg-muted px-2 py-1 text-xs">{product.category.name}</span>
      )}
      <h3 class="mt-4 text-base font-bold">${product.price.toFixed(2)}</h3>
      <p class="leading-relaxed text-muted-foreground">{product.description}</p>
      <p class={`text-xs ${inStock ? 'text-green-600' : 'text-destructive'}`}>
        {inStock ? `Stock disponible: ${product.stock} unidades` : 'Agotado'}
      </p>

      <div class="mt-8 flex gap-2.5">
        <AddToCartButton
          client:load
          product={{ id: product.id, name: product.name, price: product.price, img: product.img }}
          disabled={!inStock}
          label="Añadir al Carrito"
        />
        <a href="/carrito" class={buttonVariants({ variant: 'outline', size: 'lg' })}>
          Ir al Carrito 🛒
        </a>
      </div>
    </div>
  </div>
</div>